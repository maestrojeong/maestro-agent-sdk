# maestro-agent-sdk — environment variables
#
# Copy to .env (already gitignored) and fill in what you need. Every var
# here is read once via process.env — the SDK does NOT auto-load .env
# files itself (no bundled dotenv); wire that up in your own host process
# (e.g. `import "dotenv/config"` before importing maestro-agent-sdk) if you
# want file-based env loading.

# ─── Providers (at least one required) ──────────────────────────────────────

# DeepSeek V4 (Pro / Flash). Required for any deepseek-v4-* model.
DEEPSEEK_API_KEY=

# Kimi (Moonshot AI) — K3 and K2.7 Code. Required for kimi-k3 / kimi-k2.7-code.
MOONSHOT_API_KEY=
# Regional/proxy override. Default: https://api.moonshot.ai/v1
# China platform: https://api.moonshot.cn/v1
# MOONSHOT_BASE_URL=

# GLM (Zhipu AI) -- glm-5.3, glm-5.2, glm-5.3-flash. Required for any glm-* model.
GLM_API_KEY=
# Regional/proxy override. Default: https://open.bigmodel.cn/api/paas/v4
# GLM_BASE_URL=

# ─── Gemini image-QA fallback (View tool, non-vision models only) ──────────
# DeepSeek and GLM's glm-5.2/glm-5.3 can't inspect image pixels directly;
# when GEMINI_API_KEY is set, the SDK auto-registers a
# View({image_path, question}) tool backed by Gemini. Kimi and GLM's
# glm-5.3-flash never need this — they have native vision.

# Get a key at https://aistudio.google.com/app/apikey — omit to disable the
# View tool entirely (non-vision models fall back to text-only image handling).
GEMINI_API_KEY=

# Model for the View tool. Flash-only — Pro/Ultra tiers and any "*-lite"
# variant are rejected at call time (cost/quality policy for a lightweight
# per-call vision fallback; see assertAllowedGeminiModel in
# src/tools/builtin/gemini_image_qa.ts). Any current or future Gemini Flash
# release works — matching is substring-based ("flash" required, "lite"
# forbidden), not an exact-id allowlist.
#
# Known-good values as of 2026-07:
#   gemini-2.5-flash    (SDK default — scheduled to shut down 2026-10-16,
#                        migrate before then)
#   gemini-3-flash      (Dec 2025 release)
#   gemini-3.5-flash
#   gemini-3.6-flash     (latest GA, July 2026 — faster/cheaper than 3.5)
#
# Rejected (do not set these — the tool will return a structured error):
#   gemini-2.5-flash-lite, gemini-3.5-flash-lite   (Flash-Lite variants)
#   gemini-3.1-pro, gemini-3-pro, gemini-*-ultra    (Pro/Ultra tiers)
# GEMINI_IMAGE_QA_MODEL=gemini-2.5-flash

# ─── Session storage & data directory ───────────────────────────────────────

# Where session JSONLs live. Must be set BEFORE the SDK is
# first imported (the value is captured once at module load).
# Default: ~/.maestro
# MAESTRO_DATA_DIR=

# ─── Context / compaction ───────────────────────────────────────────────────

# Override the model's native context window (tokens) used for compaction
# and hard-cap thresholds. Only set this for testing/tuning — normally the
# provider reports its own model's real context window.
# MAESTRO_CONTEXT_WINDOW=

# ─── MCP client pool ─────────────────────────────────────────────────────────

# Idle TTL (ms) before a refcount-0 cached MCP client is evicted. Default: 300000 (5 min)
# MAESTRO_MCP_POOL_IDLE_TTL_MS=

# Hard cap on cached MCP clients (LRU eviction past this). Default: 16
# MAESTRO_MCP_POOL_MAX=

# ─── Sub-agents ──────────────────────────────────────────────────────────────

# Override the max output tokens a spawned sub-agent uses, instead of the
# default derived from the parent's model.
# MAESTRO_SUBAGENT_MAX_TOKENS=

# ─── Misc / host integration ────────────────────────────────────────────────

# Suppress the SDK's bootstrap log line on stdout (set to "1" to silence).
# Useful for hosts that pipe stdout to something MCP-sensitive (stdio MCP
# clients treat stray stdout writes as protocol frames).
# MAESTRO_SDK_SILENT_BOOTSTRAP=
