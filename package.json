{
  "name": "maestro-agent-sdk",
  "version": "0.2.1",
  "description": "Embeddable TypeScript agent SDK for DeepSeek and Kimi — built-in tools, skills, memory, and MCP.",
  "license": "MIT",
  "author": "Yeonwoo Jeong <aadd4020@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maestrojeong/maestro-agent-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/deepseek": {
      "types": "./dist/providers/deepseek.d.ts",
      "import": "./dist/providers/deepseek.js"
    },
    "./providers/kimi": {
      "types": "./dist/providers/kimi.d.ts",
      "import": "./dist/providers/kimi.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist",
    "assets/composable-agent-sdk.svg",
    "assets/sdk-positioning.svg",
    ".env.example",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && node scripts/copy-prompts.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "deepseek",
    "mcp",
    "tool-use",
    "agent-sdk",
    "hermes-agent",
    "maestro"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cheerio": "^1.2.0",
    "pdfjs-dist": "^5.7.284",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^20",
    "tsc-alias": "^1.8.17",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
